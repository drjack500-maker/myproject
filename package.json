{
  "name": "meieki-allon4-lp",
  "private": true,
  "description": "オールオン4 LP（名駅歯科クリニック・矯正歯科）",
  "scripts": {
    "serve": "node tools/serve.js",
    "serve:ibiki": "node tools/serve.js ibiki-lp",
    "test": "npm run lint:html && npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/gas.test.js",
    "test:e2e": "node --test tests/e2e.test.js tests/ibiki.e2e.test.js tests/booklet.test.js tests/funnel.test.js",
    "lint:html": "html-validate lp/*.html ibiki-lp/*.html ibiki-lp/booklet/*.html ibiki-lp/free/*.html ibiki-lp/program/*.html ibiki-lp/funnel/*.html",
    "build:images": "node tools/build-images.js",
    "build:preview": "node tools/build-preview.js",
    "build:hotfix": "node tools/build-hotfix.js",
    "build:booklet": "node tools/build-booklet.js",
    "build:bundle": "node tools/build-bundle.js"
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "html-validate": "^11.16.1",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.56.1"
  }
}
