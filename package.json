{
  "name": "meieki-allon4-lp",
  "private": true,
  "description": "オールオン4 LP（名駅歯科クリニック・矯正歯科）",
  "scripts": {
    "serve": "node tools/serve.js",
    "serve:youtube": "node tools/serve.js --youtube",
    "serve:meta": "node tools/serve.js --meta",
    "test": "npm run lint:html && npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/gas.test.js",
    "test:e2e": "node --test tests/e2e.test.js tests/youtube-lp.test.js tests/meta-lp.test.js tests/youtube-assets.test.js",
    "lint:html": "html-validate lp/*.html youtube-lp/*.html meta-lp/*.html",
    "build:images": "node tools/build-images.js",
    "build:images:youtube": "node tools/build-images.js --youtube",
    "build:images:meta": "node tools/build-images.js --meta",
    "build:youtube-assets": "node tools/build-youtube-assets.js",
    "build:preview": "node tools/build-preview.js",
    "build:preview:youtube": "node tools/build-preview.js --youtube",
    "build:preview:meta": "node tools/build-preview.js --meta",
    "build:hotfix": "node tools/build-hotfix.js",
    "sync:shared": "node tools/sync-shared.js"
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "html-validate": "^11.16.1",
    "jsqr": "^1.4.0",
    "playwright": "^1.56.1",
    "qrcode": "^1.5.4"
  }
}
